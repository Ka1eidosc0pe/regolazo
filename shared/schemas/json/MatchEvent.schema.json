{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://regolazo.dev/schemas/1.0.0/MatchEvent.json",
  "$defs": {
    "BlockQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "block",
          "default": "block",
          "type": "string"
        },
        "block_type": {
          "enum": [
            "shot_block",
            "pass_block",
            "cross_block"
          ],
          "type": "string"
        },
        "deflection": {
          "default": false,
          "type": "boolean"
        },
        "save_block": {
          "default": false,
          "type": "boolean"
        },
        "blocked_event_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "block_type",
        "deflection",
        "save_block",
        "blocked_event_id"
      ],
      "title": "BlockQ",
      "type": "object"
    },
    "CarryQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "carry",
          "default": "carry",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "retained",
            "lost",
            "end_of_period"
          ],
          "type": "string"
        },
        "distance_m": {
          "minimum": 0,
          "type": "number"
        },
        "path_m": {
          "minimum": 0,
          "type": "number"
        },
        "max_speed_mps": {
          "minimum": 0,
          "type": "number"
        },
        "is_progressive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "outcome",
        "distance_m",
        "path_m",
        "max_speed_mps",
        "is_progressive"
      ],
      "title": "CarryQ",
      "type": "object"
    },
    "ClearanceQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clearance",
          "default": "clearance",
          "type": "string"
        },
        "body_part": {
          "anyOf": [
            {
              "enum": [
                "right_foot",
                "left_foot",
                "head",
                "chest",
                "other",
                "hands",
                "no_touch",
                "left_hand",
                "right_hand",
                "both_hands"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "out_of_play",
            "in_play_safe",
            "in_play_danger"
          ],
          "type": "string"
        },
        "aerial_won": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "body_part",
        "outcome",
        "aerial_won"
      ],
      "title": "ClearanceQ",
      "type": "object"
    },
    "DuelQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "duel",
          "default": "duel",
          "type": "string"
        },
        "opponent": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duel_type": {
          "enum": [
            "tackle",
            "aerial",
            "fifty_fifty"
          ],
          "type": "string"
        },
        "outcome": {
          "enum": [
            "won",
            "lost"
          ],
          "type": "string"
        },
        "possession_after": {
          "anyOf": [
            {
              "enum": [
                "tackler",
                "teammate",
                "opponent",
                "out_of_play",
                "loose"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "opponent",
        "duel_type",
        "outcome",
        "possession_after"
      ],
      "title": "DuelQ",
      "type": "object"
    },
    "FoulQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "foul",
          "default": "foul",
          "type": "string"
        },
        "opponent": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "foul_type": {
          "default": "foul",
          "enum": [
            "foul",
            "handball",
            "dangerous_play",
            "dive",
            "six_seconds",
            "backpass_pickup"
          ],
          "type": "string"
        },
        "card": {
          "default": "none",
          "enum": [
            "none",
            "yellow",
            "second_yellow",
            "red"
          ],
          "type": "string"
        },
        "advantage": {
          "default": false,
          "type": "boolean"
        },
        "penalty": {
          "default": false,
          "type": "boolean"
        },
        "offensive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "opponent",
        "foul_type",
        "card",
        "advantage",
        "penalty",
        "offensive"
      ],
      "title": "FoulQ",
      "type": "object"
    },
    "GkQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gk_action",
          "default": "gk_action",
          "type": "string"
        },
        "action": {
          "enum": [
            "save",
            "claim",
            "punch",
            "sweeper",
            "rush_out",
            "pick_up",
            "goal_conceded"
          ],
          "type": "string"
        },
        "outcome": {
          "enum": [
            "catch",
            "parry_safe",
            "parry_danger",
            "parry_out",
            "to_post",
            "success",
            "fail",
            "collected_twice",
            "claim",
            "clear",
            "won",
            "lost_in_play",
            "lost_out",
            "in_play_safe",
            "in_play_danger",
            "out_of_play",
            "no_touch",
            "touched_in"
          ],
          "type": "string"
        },
        "technique": {
          "anyOf": [
            {
              "enum": [
                "standing",
                "diving"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body_part": {
          "anyOf": [
            {
              "enum": [
                "right_foot",
                "left_foot",
                "head",
                "chest",
                "other",
                "hands",
                "no_touch",
                "left_hand",
                "right_hand",
                "both_hands"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position_before": {
          "anyOf": [
            {
              "enum": [
                "set",
                "moving",
                "prone"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dive_distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "action",
        "outcome",
        "technique",
        "body_part",
        "shot_id",
        "position_before",
        "dive_distance_m"
      ],
      "title": "GkQ",
      "type": "object"
    },
    "InterceptionQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interception",
          "default": "interception",
          "type": "string"
        },
        "passer": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "won",
            "success_in_play",
            "success_out",
            "lost"
          ],
          "type": "string"
        },
        "pass_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "passer",
        "outcome",
        "pass_id"
      ],
      "title": "InterceptionQ",
      "type": "object"
    },
    "OffsideQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "offside",
          "default": "offside",
          "type": "string"
        },
        "passer": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "offside_line_x": {
          "type": "number"
        },
        "margin_m": {
          "type": "number"
        },
        "pass_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "passer",
        "offside_line_x",
        "margin_m",
        "pass_id"
      ],
      "title": "OffsideQ",
      "type": "object"
    },
    "OutOfPlayQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ball_out_of_play",
          "default": "ball_out_of_play",
          "type": "string"
        },
        "line": {
          "enum": [
            "touchline",
            "goal_line"
          ],
          "type": "string"
        },
        "last_touch_team": {
          "anyOf": [
            {
              "enum": [
                "home",
                "away"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_touch_player": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_restart_type": {
          "anyOf": [
            {
              "enum": [
                "kick_off",
                "throw_in",
                "goal_kick",
                "corner",
                "free_kick_direct",
                "free_kick_indirect",
                "penalty",
                "drop_ball"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "line",
        "last_touch_team",
        "last_touch_player",
        "result_restart_type"
      ],
      "title": "OutOfPlayQ",
      "type": "object"
    },
    "PassQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pass",
          "default": "pass",
          "type": "string"
        },
        "recipient": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "complete",
            "incomplete",
            "intercepted",
            "out_of_play",
            "offside"
          ],
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "enum": [
                "ground",
                "low",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "length_class": {
          "enum": [
            "short",
            "medium",
            "long"
          ],
          "type": "string"
        },
        "body_part": {
          "anyOf": [
            {
              "enum": [
                "right_foot",
                "left_foot",
                "head",
                "chest",
                "other",
                "hands",
                "no_touch",
                "left_hand",
                "right_hand",
                "both_hands"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "technique": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "driven",
                "lofted",
                "chipped",
                "curled",
                "outside_of_boot",
                "backheel"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pass_type": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "cross",
                "cutback",
                "through_ball",
                "layoff",
                "flick_on",
                "back_pass"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart": {
          "anyOf": [
            {
              "enum": [
                "kick_off",
                "throw_in",
                "goal_kick",
                "corner",
                "free_kick_direct",
                "free_kick_indirect",
                "penalty",
                "drop_ball"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "corner_delivery": {
          "anyOf": [
            {
              "enum": [
                "inswinging",
                "outswinging",
                "straight"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gk_distribution": {
          "anyOf": [
            {
              "enum": [
                "throw",
                "punt",
                "drop_kick",
                "goal_kick",
                "pass"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length_m": {
          "minimum": 0,
          "type": "number"
        },
        "angle_rad": {
          "type": "number"
        },
        "ball_speed_mps": {
          "minimum": 0,
          "type": "number"
        },
        "peak_height_m": {
          "minimum": 0,
          "type": "number"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_switch": {
          "default": false,
          "type": "boolean"
        },
        "is_progressive": {
          "default": false,
          "type": "boolean"
        },
        "is_line_breaking": {
          "default": false,
          "type": "boolean"
        },
        "lines_broken": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "is_key_pass": {
          "default": false,
          "type": "boolean"
        },
        "is_assist": {
          "default": false,
          "type": "boolean"
        },
        "first_time": {
          "default": false,
          "type": "boolean"
        },
        "deflected": {
          "default": false,
          "type": "boolean"
        },
        "recipient_offside": {
          "default": false,
          "type": "boolean"
        },
        "assisted_shot_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipt_id": {
          "anyOf": [
            {
              "examples": [
                "ev_000123"
              ],
              "pattern": "^ev_[0-9a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "xpass": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "recipient",
        "outcome",
        "height",
        "length_class",
        "body_part",
        "technique",
        "pass_type",
        "restart",
        "corner_delivery",
        "gk_distribution",
        "length_m",
        "angle_rad",
        "ball_speed_mps",
        "peak_height_m",
        "duration_s",
        "is_switch",
        "is_progressive",
        "is_line_breaking",
        "lines_broken",
        "is_key_pass",
        "is_assist",
        "first_time",
        "deflected",
        "recipient_offside",
        "assisted_shot_id",
        "receipt_id",
        "xpass"
      ],
      "title": "PassQ",
      "type": "object"
    },
    "PhysicalQ": {
      "additionalProperties": false,
      "description": "Sprint, high-intensity run or acceleration.",
      "properties": {
        "kind": {
          "const": "physical",
          "default": "physical",
          "type": "string"
        },
        "distance_m": {
          "minimum": 0,
          "type": "number"
        },
        "peak_speed_mps": {
          "minimum": 0,
          "type": "number"
        },
        "accel_type": {
          "anyOf": [
            {
              "enum": [
                "acceleration",
                "deceleration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "peak_accel_mps2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speed_start_mps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speed_end_mps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "distance_m",
        "peak_speed_mps",
        "accel_type",
        "peak_accel_mps2",
        "speed_start_mps",
        "speed_end_mps"
      ],
      "title": "PhysicalQ",
      "type": "object"
    },
    "PressingSequenceQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pressing_sequence",
          "default": "pressing_sequence",
          "type": "string"
        },
        "n_pressures": {
          "minimum": 2,
          "type": "integer"
        },
        "pressing_players": {
          "items": {
            "examples": [
              "H07",
              "A10"
            ],
            "pattern": "^[HA]\\d{2}$",
            "type": "string"
          },
          "type": "array"
        },
        "outcome": {
          "enum": [
            "success",
            "broken",
            "out",
            "whistle"
          ],
          "type": "string"
        },
        "pressure_ids": {
          "default": [],
          "items": {
            "examples": [
              "ev_000123"
            ],
            "pattern": "^ev_[0-9a-z_]+$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "n_pressures",
        "pressing_players",
        "outcome",
        "pressure_ids"
      ],
      "title": "PressingSequenceQ",
      "type": "object"
    },
    "PressureQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pressure",
          "default": "pressure",
          "type": "string"
        },
        "pressed_player": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pressed_role": {
          "enum": [
            "carrier",
            "receiver",
            "releaser"
          ],
          "type": "string"
        },
        "min_distance_m": {
          "minimum": 0,
          "type": "number"
        },
        "closing_speed_mps": {
          "type": "number"
        },
        "n_pressers": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "outcome": {
          "default": "none",
          "enum": [
            "forced_turnover",
            "forced_hurried_action",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pressed_player",
        "pressed_role",
        "min_distance_m",
        "closing_speed_mps",
        "n_pressers",
        "outcome"
      ],
      "title": "PressureQ",
      "type": "object"
    },
    "ReceiptQ": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ball_receipt",
          "default": "ball_receipt",
          "type": "string"
        },
        "passer": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "type": "string"
