{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://regolazo.dev/schemas/1.0.0/DecisionMoment.json",
  "$defs": {
    "ActionIntent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pass_player",
            "pass_space",
            "shot",
            "carry",
            "clearance"
          ],
          "type": "string"
        },
        "player": {
          "examples": [
            "H07",
            "A10"
          ],
          "pattern": "^[HA]\\d{2}$",
          "type": "string"
        },
        "target_player": {
          "anyOf": [
            {
              "examples": [
                "H07",
                "A10"
              ],
              "pattern": "^[HA]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "additionalItems": false,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "type": "array"
          },
          "type": "array"
        },
        "curve": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "power": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "pass_technique_override": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "driven",
                "lofted",
                "chipped",
                "curled",
                "outside_of_boot",
                "backheel"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_technique_override": {
          "anyOf": [
            {
              "enum": [
                "driven",
                "placed",
                "finesse",
                "chip",
                "volley",
                "half_volley",
                "header",
                "diving_header",
                "toe_poke",
                "backheel",
                "overhead_kick"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "default": "ai",
          "enum": [
            "ai",
            "fan"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "player",
        "target_player",
        "target",
        "path",
        "curve",
        "power",
        "pass_technique_override",
        "shot_technique_override",
        "source"
      ],
      "title": "ActionIntent",
      "type": "object"
    },
    "BallLaunch": {
      "additionalProperties": false,
      "properties": {
        "speed_mps": {
          "maximum": 45,
          "minimum": 0,
          "type": "number"
        },
        "elevation_rad": {
          "maximum": 1.5,
          "minimum": -0.5,
          "type": "number"
        },
        "azimuth_rad": {
          "type": "number"
        },
        "spin": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "type": "array"
        }
      },
      "required": [
        "speed_mps",
        "elevation_rad",
        "azimuth_rad",
        "spin"
      ],
      "title": "BallLaunch",
      "type": "object"
    },
    "Consequence": {
      "additionalProperties": false,
      "description": "What happened in the ~10 s after the moment in the real match.",
      "properties": {
        "kind": {
          "enum": [
            "goal",
            "shot",
            "big_chance",
            "turnover_to_chance_against",
            "possession_value_swing",
            "none"
          ],
          "type": "string"
        },
        "xt_swing": {
          "type": "number"
        },
        "horizon_s": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "event_ids": {
          "default": [],
          "items": {
            "examples": [
              "ev_000123"
            ],
            "pattern": "^ev_[0-9a-z_]+$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "xt_swing",
        "horizon_s",
        "event_ids"
      ],
      "title": "Consequence",
      "type": "object"
    },
    "ExecutionEllipse": {
      "additionalProperties": false,
      "description": "1-sigma execution uncertainty at the intended end point, sized by the player's skill and pressure.",
      "properties": {
        "plane": {
          "enum": [
            "pitch",
            "goal_mouth"
          ],
          "type": "string"
        },
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "type": "array"
        },
        "semi_major_m": {
          "minimum": 0,
          "type": "number"
        },
        "semi_minor_m": {
          "minimum": 0,
          "type": "number"
        },
        "angle_rad": {
          "type": "number"
        }
      },
      "required": [
        "plane",
        "center",
        "semi_major_m",
        "semi_minor_m",
        "angle_rad"
      ],
      "title": "ExecutionEllipse",
      "type": "object"
    },
    "OptionEvaluation": {
      "additionalProperties": false,
      "description": "One option available to the ball carrier, scored by the analytics models.",
      "properties": {
        "option_id": {
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/ActionIntent"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "type": "string"
        },
        "label_key": {
          "type": "string"
        },
        "label_args": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "p_success": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "p_success_baseline": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_if_success": {
          "type": "number"
        },
        "xg": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "xt_gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_value": {
          "type": "number"
        },
        "viable": {
          "default": true,
          "type": "boolean"
        },
        "is_real": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "option_id",
        "intent",
        "resolved",
        "label",
        "label_key",
        "label_args",
        "p_success",
        "p_success_baseline",
        "value_if_success",
        "xg",
        "xt_gain",
        "decision_value",
        "viable",
        "is_real"
      ],
      "title": "OptionEvaluation",
      "type": "object"
    },
    "ResolvedAction": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/ActionIntent"
        },
        "action_type": {
          "enum": [
            "pass",
            "shot",
            "carry",
            "dribble",
            "clearance"
          ],
          "type": "string"
        },
        "body_part": {
          "anyOf": [
            {
              "enum": [
                "right_foot",
                "left_foot",
                "head",
                "chest",
                "other",
                "hands",
                "no_touch",
                "left_hand",
                "right_hand",
                "both_hands"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pass_technique": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "driven",
                "lofted",
                "chipped",
                "curled",
                "outside_of_boot",
                "backheel"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pass_type": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "cross",
                "cutback",
                "through_ball",
                "layoff",
                "flick_on",
                "back_pass"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pass_height": {
          "anyOf": [
            {
              "enum": [
                "ground",
                "low",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_technique": {
          "anyOf": [
            {
              "enum": [
                "driven",
                "placed",
                "finesse",
                "chip",
                "volley",
                "half_volley",
                "header",
                "diving_header",
                "toe_poke",
                "backheel",
                "overhead_kick"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intended_end": {
          "maxItems": 3,
          "minItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "type": "array"
        },
        "launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BallLaunch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "curve_applied": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "ellipse": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionEllipse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preview_arc": {
          "default": [],
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "type": "array"
          },
          "type": "array"
        },
        "override_rejected": {
          "default": false,
          "type": "boolean"
        },
        "weak_foot": {
          "default": false,
          "type": "boolean"
        },
        "execution_quality": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "available_pass_techniques": {
          "default": [],
          "items": {
            "enum": [
              "standard",
              "driven",
              "lofted",
              "chipped",
              "curled",
              "outside_of_boot",
              "backheel"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "available_shot_techniques": {
          "default": [],
          "items": {
            "enum": [
              "driven",
              "placed",
              "finesse",
              "chip",
              "volley",
              "half_volley",
              "header",
              "diving_header",
              "toe_poke",
              "backheel",
              "overhead_kick"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "max_curve": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "intent",
        "action_type",
        "body_part",
        "pass_technique",
        "pass_type",
        "pass_height",
        "shot_technique",
        "intended_end",
        "launch",
        "curve_applied",
        "ellipse",
        "preview_arc",
        "override_rejected",
        "weak_foot",
        "execution_quality",
        "available_pass_techniques",
        "available_shot_techniques",
        "max_curve"
      ],
      "title": "ResolvedAction",
      "type": "object"
    },
    "RewindScores": {
      "additionalProperties": false,
      "description": "Judgement-free selection signals, each normalised to 0..1.\n\nThe value gap between the real choice and the alternatives is deliberately NOT a selection signal;\nit is used only in the verdict after the fan commits.",
      "properties": {
        "richness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "stakes": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "consequence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "salience": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "total": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "viable_options": {
          "minimum": 0,
          "type": "integer"
        },
        "option_entropy": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "richness",
        "stakes",
        "consequence",
        "salience",
        "total",
        "viable_options",
        "option_entropy"
      ],
      "title": "RewindScores",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "tick": {
      "minimum": 0,
      "type": "integer"
    },
    "t": {
      "minimum": 0,
      "type": "number"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "snapshot_ref": {
      "type": "string"
    },
    "team": {
      "enum": [
        "home",
        "away"
      ],
      "type": "string"
    },
    "ball_carrier": {
      "examples": [
        "H07",
        "A10"
      ],
      "pattern": "^[HA]\\d{2}$",
      "type": "string"
    },
    "moment_type": {
      "enum": [
        "final_pass",
        "shot",
        "one_v_one",
        "counter_attack",
        "decisive_turnover",
        "set_piece",
        "build_up",
        "other"
      ],
      "type": "string"
    },
    "origin": {
      "enum": [
        "scout",
        "fan"
      ],
      "type": "string"
    },
    "real_action": {
      "$ref": "#/$defs/ResolvedAction"
    },
    "real_event_id": {
      "anyOf": [
        {
          "examples": [
            "ev_000123"
          ],
          "pattern": "^ev_[0-9a-z_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "consequence": {
      "$ref": "#/$defs/Consequence"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/OptionEvaluation"
      },
      "type": "array"
    },
    "scores": {
      "anyOf": [
        {
          "$ref": "#/$defs/RewindScores"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flagged": {
      "default": false,
      "type": "boolean"
    },
    "hook": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "tick",
    "t",
    "period",
    "snapshot_ref",
    "team",
    "ball_carrier",
    "moment_type",
    "origin",
    "real_action",
    "real_event_id",
    "consequence",
    "options",
    "scores",
    "flagged",
    "hook"
  ],
  "title": "DecisionMoment",
  "type": "object"
}
