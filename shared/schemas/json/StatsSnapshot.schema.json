{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://regolazo.dev/schemas/1.0.0/StatsSnapshot.json",
  "$defs": {
    "PlayerStats": {
      "additionalProperties": false,
      "properties": {
        "team": {
          "enum": [
            "home",
            "away"
          ],
          "type": "string"
        },
        "touches": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "passes": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "passes_completed": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "key_passes": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "progressive_passes": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "progressive_carries": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "shots": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "goals": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "assists": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "xg": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "xt_generated": {
          "default": 0.0,
          "type": "number"
        },
        "take_ons_won": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "tackles_won": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "interceptions": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "pressures": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "distance_m": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "top_speed_kmh": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "sprints": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "high_intensity_runs": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "longest_pass_m": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "fastest_shot_kmh": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "team",
        "touches",
        "passes",
        "passes_completed",
        "key_passes",
        "progressive_passes",
        "progressive_carries",
        "shots",
        "goals",
        "assists",
        "xg",
        "xt_generated",
        "take_ons_won",
        "tackles_won",
        "interceptions",
        "pressures",
        "distance_m",
        "top_speed_kmh",
        "sprints",
        "high_intensity_runs",
        "longest_pass_m",
        "fastest_shot_kmh"
      ],
      "title": "PlayerStats",
      "type": "object"
    },
    "TeamStats": {
      "additionalProperties": false,
      "properties": {
        "goals": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "shots": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "shots_on_target": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "xg": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "passes": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "passes_completed": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "pass_accuracy": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "possession": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "progressive_passes": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "final_third_entries": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "pressures": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "ppda": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_tilt": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "xt_generated": {
          "default": 0.0,
          "type": "number"
        },
        "distance_km": {
          "default": 0.0,
          "minimum": 0,
          "type": "number"
        },
        "sprints": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "corners": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "fouls": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "goals",
        "shots",
        "shots_on_target",
        "xg",
        "passes",
        "passes_completed",
        "pass_accuracy",
        "possession",
        "progressive_passes",
        "final_third_entries",
        "pressures",
        "ppda",
        "field_tilt",
        "xt_generated",
        "distance_km",
        "sprints",
        "corners",
        "fouls"
      ],
      "title": "TeamStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "type": "string"
    },
    "t": {
      "minimum": 0,
      "type": "number"
    },
    "teams": {
      "additionalProperties": {
        "$ref": "#/$defs/TeamStats"
      },
      "propertyNames": {
        "enum": [
          "home",
          "away"
        ]
      },
      "type": "object"
    },
    "players": {
      "patternProperties": {
        "^[HA]\\d{2}$": {
          "$ref": "#/$defs/PlayerStats"
        }
      },
      "propertyNames": {
        "examples": [
          "H07",
          "A10"
        ]
      },
      "type": "object"
    },
    "control_chaos": {
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    },
    "momentum": {
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    },
    "milestones": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "t",
    "teams",
    "players",
    "control_chaos",
    "momentum",
    "milestones"
  ],
  "title": "StatsSnapshot",
  "type": "object"
}
